#!/usr/bin/env sh
# pre-push: full gate (lint + typecheck + test) before pushing
set -eu

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(dirname "$HOOK_DIR")"

echo "=== pre-push: running full gate ==="

cd "$REPO_ROOT"

if [ -x "$REPO_ROOT/scripts/run-gate.sh" ]; then
  bash "$REPO_ROOT/scripts/run-gate.sh" all || {
    echo "pre-push: gate failed. Fix issues before pushing." >&2
    exit 1
  }
else
  echo "[1/3] Lint..."
  npm run lint || exit 1
  echo "[2/3] TypeCheck..."
  npm run typecheck || exit 1
  echo "[3/3] Test..."
  npm test -- --ci --passWithNoTests || exit 1
fi

echo "=== pre-push: PASSED ==="
