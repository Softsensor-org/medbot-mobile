#!/usr/bin/env sh
# pre-commit: fast lint + typecheck on staged changes
set -eu

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(dirname "$HOOK_DIR")"

echo "=== pre-commit: lint + typecheck ==="

cd "$REPO_ROOT"

echo "[1/2] Lint..."
npm run lint --silent 2>&1 || {
  echo "pre-commit: lint failed. Fix errors before committing." >&2
  exit 1
}

echo "[2/2] TypeCheck..."
npm run typecheck --silent 2>&1 || {
  echo "pre-commit: typecheck failed. Fix type errors before committing." >&2
  exit 1
}

echo "=== pre-commit: PASSED ==="
